<odoo>
  <record id="module_category_esg" model="ir.module.category"><field name="name">EcoSphere ESG</field><field name="sequence">40</field></record>
  <record id="group_esg_user" model="res.groups"><field name="name">ESG User</field><field name="category_id" ref="module_category_esg"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
  <record id="group_esg_admin" model="res.groups"><field name="name">ESG Admin</field><field name="category_id" ref="module_category_esg"/><field name="implied_ids" eval="[(4, ref('group_esg_user'))]"/></record>
  <record id="group_esg_manager" model="res.groups"><field name="name">ESG Manager</field><field name="category_id" ref="module_category_esg"/><field name="implied_ids" eval="[(4, ref('group_esg_admin'))]"/></record>

  <record id="rule_esg_policy_admin_all" model="ir.rule">
    <field name="name">ESG policy admin access</field>
    <field name="model_id" ref="model_esg_policy"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_esg_admin'))]"/>
  </record>

  <record id="rule_esg_policy_employee_assigned" model="ir.rule">
    <field name="name">ESG policy employee assigned access</field>
    <field name="model_id" ref="model_esg_policy"/>
    <field name="domain_force">[
      ('state', 'in', ['published', 'active', 'effective']),
      '|', '|', '|',
      ('assignment_type', '=', 'all'),
      ('assignment_employee_id.user_id', '=', user.id),
      ('assignment_department_id', 'child_of', user.employee_id.esg_department_id and [user.employee_id.esg_department_id.id] or [0]),
      ('acknowledgement_ids.employee_id.user_id', '=', user.id)
    ]</field>
    <field name="groups" eval="[(4, ref('group_esg_user'))]"/>
  </record>

  <record id="rule_esg_policy_ack_admin_all" model="ir.rule">
    <field name="name">ESG policy acknowledgement admin access</field>
    <field name="model_id" ref="model_esg_policy_acknowledgement"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_esg_admin'))]"/>
  </record>

  <record id="rule_esg_policy_ack_employee_own" model="ir.rule">
    <field name="name">ESG policy acknowledgement employee own access</field>
    <field name="model_id" ref="model_esg_policy_acknowledgement"/>
    <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_esg_user'))]"/>
  </record>

  <record id="rule_esg_audit_admin_all" model="ir.rule">
    <field name="name">ESG audit admin access</field>
    <field name="model_id" ref="model_esg_audit"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_esg_admin'))]"/>
  </record>

  <record id="rule_esg_audit_employee_visible" model="ir.rule">
    <field name="name">ESG audit employee assigned access</field>
    <field name="model_id" ref="model_esg_audit"/>
    <field name="domain_force">[
      '|',
      ('auditor_id.user_id', '=', user.id),
      ('department_id', 'child_of', user.employee_id.esg_department_id and [user.employee_id.esg_department_id.id] or [0])
    ]</field>
    <field name="groups" eval="[(4, ref('group_esg_user'))]"/>
  </record>

  <record id="rule_esg_issue_admin_all" model="ir.rule">
    <field name="name">ESG compliance issue admin access</field>
    <field name="model_id" ref="model_esg_compliance_issue"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_esg_admin'))]"/>
  </record>

  <record id="rule_esg_issue_employee_visible" model="ir.rule">
    <field name="name">ESG compliance issue employee visible access</field>
    <field name="model_id" ref="model_esg_compliance_issue"/>
    <field name="domain_force">[
      '|',
      ('owner_id.user_id', '=', user.id),
      ('create_uid', '=', user.id)
    ]</field>
    <field name="groups" eval="[(4, ref('group_esg_user'))]"/>
  </record>
</odoo>

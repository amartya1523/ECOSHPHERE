# Copy this file to backend/.env, then choose a strong local password.
POSTGRES_DB=ecosphere_db
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-this-to-a-strong-local-password
ODOO_PORT=8069
# Google Cloud OAuth 2.0 Web application Client ID. The authorized redirect URI
# for local development is http://localhost:5173/auth_oauth/signin.
GOOGLE_OAUTH_CLIENT_ID=
# Optional: server-side photo verification for the Plant a Greener Future challenge.
# Never expose this key in frontend code or commit backend/.env.
ECOSPHERE_VISION_API_KEY=

# Optional: server-side Groq LLM for the EcoSphere AI query Router/Responder.
# Keep this in backend/.env or your deployment secrets, never in frontend code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

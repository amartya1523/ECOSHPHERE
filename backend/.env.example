# Copy this file to backend/.env, then choose a strong local password.
POSTGRES_DB=ecosphere_db
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-this-to-a-strong-local-password
ODOO_PORT=8069
# Optional: server-side photo verification for the Plant a Greener Future challenge.
# Never expose this key in frontend code or commit backend/.env.
ECOSPHERE_VISION_API_KEY=

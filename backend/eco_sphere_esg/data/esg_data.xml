<odoo noupdate="1">
  <record id="seq_carbon_transaction" model="ir.sequence"><field name="name">Carbon Transaction</field><field name="code">esg.carbon.transaction</field><field name="prefix">CO2/%(year)s/</field><field name="padding">5</field></record>
  <record id="category_csr_environment" model="esg.category"><field name="name">Environment</field><field name="category_type">csr</field></record>
  <record id="category_challenge_carbon" model="esg.category"><field name="name">Carbon Reduction</field><field name="category_type">challenge</field></record>
  <record id="factor_electricity" model="esg.emission.factor"><field name="name">Grid Electricity</field><field name="source_type">manual</field><field name="unit">kWh</field><field name="co2e_factor">0.708</field><field name="effective_from">2026-01-01</field></record>
  <record id="badge_green_beginner" model="esg.badge"><field name="name">Green Beginner</field><field name="description">Awarded for your first completed challenge.</field><field name="minimum_challenges">1</field></record>
  <record id="badge_carbon_saver" model="esg.badge"><field name="name">Carbon Saver</field><field name="description">Earn 500 sustainability XP.</field><field name="minimum_xp">500</field></record>
  <record id="ir_cron_esg_compliance_overdue" model="ir.cron"><field name="name">EcoSphere: Flag overdue compliance issues</field><field name="model_id" ref="model_esg_compliance_issue"/><field name="state">code</field><field name="code">model._cron_update_overdue()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="numbercall">-1</field><field name="active">True</field></record>
  <record id="ir_cron_esg_policy_ack_reminder" model="ir.cron"><field name="name">EcoSphere: Policy acknowledgement reminders</field><field name="model_id" ref="model_esg_policy"/><field name="state">code</field><field name="code">model._cron_send_acknowledgement_reminders()</field><field name="interval_number">7</field><field name="interval_type">days</field><field name="numbercall">-1</field><field name="active">True</field></record>
  <record id="ir_cron_esg_badge_award" model="ir.cron"><field name="name">EcoSphere: Award badges</field><field name="model_id" ref="model_esg_badge"/><field name="state">code</field><field name="code">model._cron_auto_award_badges()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="numbercall">-1</field><field name="active">True</field></record>
  <record id="ir_cron_esg_score_recalculation" model="ir.cron"><field name="name">EcoSphere: Recalculate ESG scores</field><field name="model_id" ref="model_esg_department_score"/><field name="state">code</field><field name="code">model._cron_recalculate_scores()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="numbercall">-1</field><field name="active">True</field></record>
</odoo>

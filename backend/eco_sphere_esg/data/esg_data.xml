<odoo noupdate="1">
  <record id="seq_carbon_transaction" model="ir.sequence"><field name="name">Carbon Transaction</field><field name="code">esg.carbon.transaction</field><field name="prefix">CO2/%(year)s/</field><field name="padding">5</field></record>
  <record id="category_csr_environment" model="esg.category"><field name="name">Environment</field><field name="category_type">csr</field></record>
  <record id="category_challenge_carbon" model="esg.category"><field name="name">Carbon Reduction</field><field name="category_type">challenge</field></record>
  <record id="factor_electricity" model="esg.emission.factor"><field name="name">Grid Electricity</field><field name="source_type">manual</field><field name="unit">kWh</field><field name="co2e_factor">0.708</field><field name="effective_from">2026-01-01</field></record>
  <record id="badge_green_beginner" model="esg.badge"><field name="name">Green Beginner</field><field name="description">Awarded for your first completed challenge.</field><field name="minimum_challenges">1</field></record>
  <record id="badge_carbon_saver" model="esg.badge"><field name="name">Carbon Saver</field><field name="description">Earn 500 sustainability XP.</field><field name="minimum_xp">500</field></record>
</odoo>

<odoo>
  <record id="view_esg_report_builder_form" model="ir.ui.view">
    <field name="name">esg.report.builder.form</field>
    <field name="model">esg.report.builder</field>
    <field name="arch" type="xml">
      <form string="Custom ESG Report Builder">
        <group>
          <group string="Date Range">
            <field name="date_from" string="From"/>
            <field name="date_to"   string="To"/>
          </group>
          <group string="Filters">
            <field name="module"/>
            <field name="department_id"/>
            <field name="employee_id"/>
            <field name="challenge_id"/>
            <field name="category_id"/>
          </group>
        </group>
        <footer>
          <button name="action_run_report"   type="object" string="Run Report"    class="btn-primary"/>
          <button name="action_export_pdf"   type="object" string="Export PDF"/>
          <button name="action_export_excel" type="object" string="Export Excel"/>
          <button name="action_export_csv"   type="object" string="Export CSV"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_esg_report_builder" model="ir.actions.act_window">
    <field name="name">Custom Report Builder</field>
    <field name="res_model">esg.report.builder</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>

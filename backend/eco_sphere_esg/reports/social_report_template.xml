<odoo>
  <template id="social_report_document">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <h2>Social Report — CSR Activities</h2>
          <p>Generated: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/></p>
          <t t-foreach="docs" t-as="activity">
            <h4><t t-esc="activity.name"/> <small class="text-muted">(<t t-esc="activity.activity_date"/>)</small></h4>
            <p><strong>Department:</strong> <t t-esc="activity.department_id.name if activity.department_id else 'N/A'"/>
               &amp;nbsp;|&amp;nbsp;
               <strong>Points:</strong> <t t-esc="activity.points"/>
            </p>
            <t t-if="activity.participation_ids">
              <table class="table table-bordered table-sm">
                <thead class="thead-light">
                  <tr>
                    <th>Employee</th>
                    <th>Status</th>
                    <th>Points Earned</th>
                    <th>Completion Date</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="activity.participation_ids" t-as="p">
                    <tr>
                      <td><t t-esc="p.employee_id.name if p.employee_id else ''"/></td>
                      <td><t t-esc="p.state"/></td>
                      <td><t t-esc="p.points_earned"/></td>
                      <td><t t-esc="p.completion_date or ''"/></td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </t>
            <t t-else="">
              <p class="text-muted">No participation records.</p>
            </t>
          </t>
        </div>
      </t>
    </t>
  </template>
</odoo>

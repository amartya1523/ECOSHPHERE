 <record id="action_esg_department" model="ir.actions.act_window"><field name="name">Departments</field><field name="res_model">esg.department</field><field name="view_mode">tree,form</field></record>
 <record id="view_esg_category_tree" model="ir.ui.view"><field name="name">esg.category.tree</field><field name="model">esg.category</field><field name="arch" type="xml"><tree><field name="name"/><field name="category_type"/><field name="active"/></tree></field></record>

<odoo>
 <record id="view_esg_factor_tree" model="ir.ui.view"><field name="name">esg.factor.tree</field><field name="model">esg.emission.factor</field><field name="arch" type="xml"><list><field name="name"/><field name="source_type"/><field name="unit"/><field name="co2e_factor"/><field name="effective_from"/><field name="effective_to"/><field name="active"/></list></field></record>
 <record id="view_esg_factor_form" model="ir.ui.view"><field name="name">esg.factor.form</field><field name="model">esg.emission.factor</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="source_type"/><field name="unit"/><field name="co2e_factor"/><field name="effective_from"/><field name="effective_to"/><field name="active"/></group></sheet></form></field></record>
 <record id="action_esg_factor" model="ir.actions.act_window"><field name="name">Emission Factors</field><field name="res_model">esg.emission.factor</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_product_profile_tree" model="ir.ui.view"><field name="name">esg.product.profile.tree</field><field name="model">esg.product.profile</field><field name="arch" type="xml"><list><field name="product_id"/><field name="emission_factor_id"/><field name="recyclable_content"/><field name="active"/></list></field></record>
 <record id="view_esg_product_profile_form" model="ir.ui.view"><field name="name">esg.product.profile.form</field><field name="model">esg.product.profile</field><field name="arch" type="xml"><form><sheet><group><field name="product_id"/><field name="emission_factor_id"/><field name="recyclable_content"/><field name="active"/><field name="notes"/></group></sheet></form></field></record>
 <record id="action_esg_product_profile" model="ir.actions.act_window"><field name="name">Product ESG Profiles</field><field name="res_model">esg.product.profile</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_carbon_tree" model="ir.ui.view"><field name="name">esg.carbon.tree</field><field name="model">esg.carbon.transaction</field><field name="arch" type="xml"><list><field name="name"/><field name="transaction_date"/><field name="department_id"/><field name="emission_factor_id"/><field name="quantity"/><field name="co2e_kg"/><field name="is_auto_calculated"/><field name="purchase_line_id"/></list></field></record>
 <record id="view_esg_carbon_form" model="ir.ui.view"><field name="name">esg.carbon.form</field><field name="model">esg.carbon.transaction</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="transaction_date"/><field name="department_id"/><field name="emission_factor_id"/><field name="quantity"/><field name="co2e_kg"/><field name="source_reference"/><field name="is_auto_calculated"/><field name="purchase_line_id"/><field name="notes"/></group></sheet><chatter/></form></field></record>
 <record id="view_esg_carbon_search" model="ir.ui.view"><field name="name">esg.carbon.search</field><field name="model">esg.carbon.transaction</field><field name="arch" type="xml"><search><field name="department_id"/><field name="transaction_date"/><filter name="manual" string="Manual" domain="[('is_auto_calculated','=',False)]"/><filter name="automatic" string="Automatic" domain="[('is_auto_calculated','=',True)]"/><group expand="0" string="Group By"><filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/><filter name="group_month" string="Month" context="{'group_by': 'transaction_date:month'}"/></group></search></field></record>
 <record id="action_esg_carbon" model="ir.actions.act_window"><field name="name">Carbon Transactions</field><field name="res_model">esg.carbon.transaction</field><field name="view_mode">list,form,graph,pivot</field><field name="search_view_id" ref="view_esg_carbon_search"/></record>
 <record id="view_esg_goal_tree" model="ir.ui.view"><field name="name">esg.goal.tree</field><field name="model">esg.environmental.goal</field><field name="arch" type="xml"><list decoration-success="state == 'completed'"><field name="name"/><field name="department_id"/><field name="target_metric"/><field name="target_value"/><field name="current_value"/><field name="progress" widget="progressbar"/><field name="deadline"/><field name="state" widget="badge"/></list></field></record>
 <record id="view_esg_goal_form" model="ir.ui.view"><field name="name">esg.goal.form</field><field name="model">esg.environmental.goal</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="department_id"/><field name="target_metric"/><field name="target_value"/><field name="current_value"/><field name="progress" widget="progressbar"/><field name="deadline"/><field name="state"/></group></sheet><chatter/></form></field></record>
 <record id="action_esg_goal" model="ir.actions.act_window"><field name="name">Environmental Goals</field><field name="res_model">esg.environmental.goal</field><field name="view_mode">list,form</field></record>
</odoo>

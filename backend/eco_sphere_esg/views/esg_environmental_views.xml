<odoo>
 <record id="view_esg_factor_tree" model="ir.ui.view"><field name="name">esg.factor.tree</field><field name="model">esg.emission.factor</field><field name="arch" type="xml"><list><field name="name"/><field name="source_type"/><field name="unit"/><field name="co2e_factor"/><field name="active"/></list></field></record>
 <record id="action_esg_factor" model="ir.actions.act_window"><field name="name">Emission Factors</field><field name="res_model">esg.emission.factor</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_product_profile_tree" model="ir.ui.view"><field name="name">esg.product.profile.tree</field><field name="model">esg.product.profile</field><field name="arch" type="xml"><list><field name="product_id"/><field name="emission_factor_id"/><field name="recyclable_content"/></list></field></record>
 <record id="action_esg_product_profile" model="ir.actions.act_window"><field name="name">Product ESG Profiles</field><field name="res_model">esg.product.profile</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_carbon_tree" model="ir.ui.view"><field name="name">esg.carbon.tree</field><field name="model">esg.carbon.transaction</field><field name="arch" type="xml"><list><field name="name"/><field name="transaction_date"/><field name="department_id"/><field name="emission_factor_id"/><field name="quantity"/><field name="co2e_kg"/><field name="is_auto_calculated"/></list></field></record>
 <record id="view_esg_carbon_form" model="ir.ui.view"><field name="name">esg.carbon.form</field><field name="model">esg.carbon.transaction</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="transaction_date"/><field name="department_id"/><field name="emission_factor_id"/><field name="quantity"/><field name="co2e_kg"/><field name="source_reference"/><field name="notes"/></group></sheet><chatter/></form></field></record>
 <record id="action_esg_carbon" model="ir.actions.act_window"><field name="name">Carbon Transactions</field><field name="res_model">esg.carbon.transaction</field><field name="view_mode">list,form,graph,pivot</field></record>
 <record id="view_esg_goal_tree" model="ir.ui.view"><field name="name">esg.goal.tree</field><field name="model">esg.environmental.goal</field><field name="arch" type="xml"><list decoration-success="state == 'completed'"><field name="name"/><field name="department_id"/><field name="target_co2e"/><field name="current_co2e"/><field name="progress" widget="progressbar"/><field name="deadline"/><field name="state" widget="badge"/></list></field></record>
 <record id="action_esg_goal" model="ir.actions.act_window"><field name="name">Environmental Goals</field><field name="res_model">esg.environmental.goal</field><field name="view_mode">list,form</field></record>
</odoo>

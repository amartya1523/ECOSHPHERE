<odoo>
 <record id="view_esg_challenge_kanban" model="ir.ui.view"><field name="name">esg.challenge.kanban</field><field name="model">esg.challenge</field><field name="arch" type="xml"><kanban default_group_by="state"><field name="name"/><field name="xp_value"/><field name="difficulty"/><field name="deadline"/><templates><t t-name="kanban-box"><div class="oe_kanban_global_click"><strong><field name="name"/></strong><div><field name="difficulty"/> · <field name="xp_value"/> XP</div><div>Due: <field name="deadline"/></div></div></t></templates></kanban></field></record>
 <record id="view_esg_challenge_form" model="ir.ui.view"><field name="name">esg.challenge.form</field><field name="model">esg.challenge</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activate" invisible="state != 'draft'"/><button name="action_review" type="object" string="Send to Review" invisible="state != 'active'"/><button name="action_complete" type="object" string="Complete" invisible="state != 'under_review'"/><button name="action_archive" type="object" string="Archive" invisible="state == 'archived'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,under_review,completed,archived"/></header><sheet><group><field name="name"/><field name="category_id"/><field name="xp_value"/><field name="difficulty"/><field name="deadline"/><field name="evidence_required"/><field name="description"/></group></sheet><chatter/></form></field></record>
 <record id="action_esg_challenge" model="ir.actions.act_window"><field name="name">Challenges</field><field name="res_model">esg.challenge</field><field name="view_mode">kanban,list,form</field></record>
 <record id="view_esg_challenge_part_tree" model="ir.ui.view"><field name="name">esg.challenge.part.tree</field><field name="model">esg.challenge.participation</field><field name="arch" type="xml"><tree><field name="employee_id"/><field name="challenge_id"/><field name="progress" widget="progressbar"/><field name="proof_filename"/><field name="xp_awarded"/><field name="state" widget="badge"/><button name="action_submit" type="object" string="Submit" invisible="state != 'joined'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'under_review'"/></tree></field></record>
 <record id="action_esg_challenge_part" model="ir.actions.act_window"><field name="name">Challenge Participation</field><field name="res_model">esg.challenge.participation</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_badge_tree" model="ir.ui.view"><field name="name">esg.badge.tree</field><field name="model">esg.badge</field><field name="arch" type="xml"><tree><field name="name"/><field name="minimum_xp"/><field name="minimum_challenges"/></tree></field></record>
 <record id="action_esg_badge" model="ir.actions.act_window"><field name="name">Badges</field><field name="res_model">esg.badge</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_reward_tree" model="ir.ui.view"><field name="name">esg.reward.tree</field><field name="model">esg.reward</field><field name="arch" type="xml"><tree><field name="name"/><field name="points_required"/><field name="stock"/><field name="active"/></tree></field></record>
 <record id="action_esg_reward" model="ir.actions.act_window"><field name="name">Rewards</field><field name="res_model">esg.reward</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_redemption_tree" model="ir.ui.view"><field name="name">esg.redemption.tree</field><field name="model">esg.reward.redemption</field><field name="arch" type="xml"><tree><field name="employee_id"/><field name="reward_id"/><field name="points_spent"/><field name="redeemed_on"/><field name="state" widget="badge"/><button name="action_cancel" type="object" string="Cancel" invisible="state != 'requested'"/></tree></field></record>
 <record id="action_esg_redemption" model="ir.actions.act_window"><field name="name">Reward Redemptions</field><field name="res_model">esg.reward.redemption</field><field name="view_mode">list,form</field></record>
 <record id="action_esg_score" model="ir.actions.act_window"><field name="name">Leaderboard</field><field name="res_model">esg.department.score</field><field name="view_mode">list,pivot,graph</field></record>
</odoo>

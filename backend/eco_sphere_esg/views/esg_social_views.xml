<odoo>
 <record id="view_esg_csr_kanban" model="ir.ui.view"><field name="name">esg.csr.kanban</field><field name="model">esg.csr.activity</field><field name="arch" type="xml"><kanban><field name="name"/><field name="activity_date"/><field name="evidence_required"/><field name="participant_count"/><templates><t t-name="kanban-box"><div class="oe_kanban_global_click"><strong><field name="name"/></strong><div><field name="activity_date"/></div><div>Participants: <field name="participant_count"/></div><div t-if="record.evidence_required.raw_value">Evidence required</div></div></t></templates></kanban></field></record>
 <record id="action_esg_csr_activity" model="ir.actions.act_window"><field name="name">CSR Activities</field><field name="res_model">esg.csr.activity</field><field name="view_mode">kanban,tree,form</field></record>
 <record id="view_esg_csr_part_tree" model="ir.ui.view"><field name="name">esg.csr.part.tree</field><field name="model">esg.csr.participation</field><field name="arch" type="xml"><tree><field name="employee_id"/><field name="activity_id"/><field name="proof_filename"/><field name="points_earned"/><field name="state" widget="badge"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'"/><button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/></tree></field></record>
 <record id="action_esg_csr_participation" model="ir.actions.act_window"><field name="name">Employee Participation</field><field name="res_model">esg.csr.participation</field><field name="view_mode">tree,form</field></record>
</odoo>

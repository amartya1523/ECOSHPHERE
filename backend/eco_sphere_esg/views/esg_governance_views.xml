<odoo>
 <record id="view_esg_policy_tree" model="ir.ui.view"><field name="name">esg.policy.tree</field><field name="model">esg.policy</field><field name="arch" type="xml"><tree><field name="reference"/><field name="name"/><field name="effective_date"/><field name="active"/></tree></field></record>
 <record id="action_esg_policy" model="ir.actions.act_window"><field name="name">Policies</field><field name="res_model">esg.policy</field><field name="view_mode">tree,form</field></record>
 <record id="view_esg_policy_ack_tree" model="ir.ui.view"><field name="name">esg.policy.ack.tree</field><field name="model">esg.policy.acknowledgement</field><field name="arch" type="xml"><tree><field name="policy_id"/><field name="employee_id"/><field name="acknowledged_on"/><field name="state" widget="badge"/><button name="action_acknowledge" type="object" string="Acknowledge" invisible="state == 'acknowledged'"/></tree></field></record>
 <record id="action_esg_policy_ack" model="ir.actions.act_window"><field name="name">Policy Acknowledgements</field><field name="res_model">esg.policy.acknowledgement</field><field name="view_mode">tree,form</field></record>
 <record id="view_esg_audit_tree" model="ir.ui.view"><field name="name">esg.audit.tree</field><field name="model">esg.audit</field><field name="arch" type="xml"><tree><field name="name"/><field name="department_id"/><field name="auditor_id"/><field name="audit_date"/><field name="findings"/><field name="state" widget="badge"/></tree></field></record>
 <record id="action_esg_audit" model="ir.actions.act_window"><field name="name">Audits</field><field name="res_model">esg.audit</field><field name="view_mode">tree,form</field></record>
 <record id="view_esg_issue_tree" model="ir.ui.view"><field name="name">esg.issue.tree</field><field name="model">esg.compliance.issue</field><field name="arch" type="xml"><tree decoration-danger="is_overdue"><field name="name"/><field name="severity" widget="badge"/><field name="department_id"/><field name="owner_id"/><field name="due_date"/><field name="is_overdue"/><field name="state" widget="badge"/><button name="action_resolve" type="object" string="Resolve" invisible="state == 'resolved'"/></tree></field></record>
 <record id="action_esg_issue" model="ir.actions.act_window"><field name="name">Compliance Issues</field><field name="res_model">esg.compliance.issue</field><field name="view_mode">tree,form</field></record>
</odoo>

<odoo>
  <record id="res_config_settings_view_form_esg" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.esg</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="EcoSphere ESG" name="eco_sphere_esg">
          <!-- ============ ESG Score Weights ============ -->
          <block title="ESG Score Weights">
            <setting string="Environmental weight (%)">
              <field name="environmental_weight"/>
            </setting>
            <setting string="Social weight (%)">
              <field name="social_weight"/>
            </setting>
            <setting string="Governance weight (%)">
              <field name="governance_weight"/>
              <span class="text-muted">Weights must sum to 100.</span>
            </setting>
          </block>
          <!-- ============ Feature Toggles ============ -->
          <block title="Feature Toggles">
            <setting string="Enable auto emission calculation" help="Automatically create carbon transactions from Purchase/Expense/Fleet records.">
              <field name="auto_emission_calculation"/>
            </setting>
            <setting string="Require evidence for all CSR activities" help="Prevent approval without an uploaded proof attachment.">
              <field name="require_csr_evidence"/>
            </setting>
            <setting string="Auto-award badges on challenge completion" help="Run badge unlock-rule checks automatically when a participation is approved.">
              <field name="auto_award_badges"/>
            </setting>
          </block>
          <!-- ============ Notification Settings (Phase 16) ============ -->
          <block title="Notification Settings">
            <setting string="Compliance issue notifications" help="Notify when a new compliance issue is raised.">
              <field name="compliance_notifications"/>
            </setting>
            <setting string="CSR participation notifications" help="Notify employees on CSR activity approval or rejection.">
              <field name="csr_notifications"/>
            </setting>
            <setting string="Challenge participation notifications" help="Notify employees on challenge approval or rejection.">
              <field name="challenge_notifications"/>
            </setting>
            <setting string="Policy acknowledgement reminder notifications" help="Send weekly reminders to employees with pending policy acknowledgements.">
              <field name="policy_notifications"/>
            </setting>
            <setting string="Badge unlock notifications" help="Notify employees when they earn a new badge.">
              <field name="badge_notifications"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>

  <record id="action_esg_settings" model="ir.actions.act_window">
    <field name="name">ESG Settings</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="target">inline</field>
    <field name="context">{'module': 'eco_sphere_esg'}</field>
  </record>
</odoo>

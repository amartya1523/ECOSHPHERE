<odoo>
  <record id="purchase_order_form_esg_inherit" model="ir.ui.view">
    <field name="name">purchase.order.form.esg.inherit</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="esg_department_id"/>
      </xpath>
    </field>
  </record>
</odoo>

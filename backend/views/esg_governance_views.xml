<odoo>
 <record id="view_esg_policy_tree" model="ir.ui.view"><field name="name">esg.policy.tree</field><field name="model">esg.policy</field><field name="arch" type="xml"><list><field name="reference"/><field name="name"/><field name="effective_date"/><field name="state" widget="badge"/><field name="active"/></list></field></record>
 <record id="view_esg_policy_form" model="ir.ui.view"><field name="name">esg.policy.form</field><field name="model">esg.policy</field><field name="arch" type="xml"><form><header><button name="action_make_effective" type="object" string="Make Effective" class="btn-primary" invisible="state != 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,effective,archived"/></header><sheet><group><field name="reference"/><field name="name"/><field name="effective_date"/><field name="document" filename="document_filename"/><field name="document_filename" invisible="1"/><field name="active"/></group><group><field name="content"/></group></sheet><chatter/></form></field></record>
 <record id="action_esg_policy" model="ir.actions.act_window"><field name="name">Policies</field><field name="res_model">esg.policy</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_policy_ack_tree" model="ir.ui.view"><field name="name">esg.policy.ack.tree</field><field name="model">esg.policy.acknowledgement</field><field name="arch" type="xml"><list><field name="policy_id"/><field name="employee_id"/><field name="acknowledged_on"/><field name="state" widget="badge"/><button name="action_acknowledge" type="object" string="Acknowledge" invisible="state == 'acknowledged'"/></list></field></record>
 <record id="action_esg_policy_ack" model="ir.actions.act_window"><field name="name">Policy Acknowledgements</field><field name="res_model">esg.policy.acknowledgement</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_audit_tree" model="ir.ui.view"><field name="name">esg.audit.tree</field><field name="model">esg.audit</field><field name="arch" type="xml"><list><field name="name"/><field name="department_id"/><field name="auditor_id"/><field name="audit_date"/><field name="findings"/><field name="state" widget="badge"/></list></field></record>
 <record id="action_esg_audit" model="ir.actions.act_window"><field name="name">Audits</field><field name="res_model">esg.audit</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_issue_tree" model="ir.ui.view"><field name="name">esg.issue.tree</field><field name="model">esg.compliance.issue</field><field name="arch" type="xml"><list decoration-danger="is_overdue"><field name="name"/><field name="severity" widget="badge"/><field name="department_id"/><field name="owner_id"/><field name="due_date"/><field name="is_overdue"/><field name="state" widget="badge"/><button name="action_resolve" type="object" string="Resolve" invisible="state == 'resolved'"/></list></field></record>
 <record id="action_esg_issue" model="ir.actions.act_window"><field name="name">Compliance Issues</field><field name="res_model">esg.compliance.issue</field><field name="view_mode">list,form</field></record>
</odoo>

<odoo>
 <record id="view_esg_policy_tree" model="ir.ui.view"><field name="name">esg.policy.tree</field><field name="model">esg.policy</field><field name="arch" type="xml"><list><field name="name"/><field name="category_id"/><field name="version"/><field name="effective_date"/><field name="review_date"/><field name="acknowledgement_required"/><field name="acknowledgement_progress"/><field name="state" widget="badge"/></list></field></record>
 <record id="view_esg_policy_form" model="ir.ui.view"><field name="name">esg.policy.form</field><field name="model">esg.policy</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'" groups="eco_sphere_esg.group_esg_admin"/><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state not in ('draft', 'published')" groups="eco_sphere_esg.group_esg_admin"/><button name="action_mark_reviewed" type="object" string="Mark Reviewed" invisible="state == 'archived'" groups="eco_sphere_esg.group_esg_admin"/><button name="action_send_acknowledgement_reminders" type="object" string="Send Reminders" invisible="state == 'archived'" groups="eco_sphere_esg.group_esg_admin"/><button name="action_archive" type="object" string="Archive" invisible="state == 'archived'" groups="eco_sphere_esg.group_esg_admin"/><field name="state" widget="statusbar" statusbar_visible="draft,published,active,archived"/></header><sheet><group string="Policy Details"><field name="reference" readonly="1"/><field name="name"/><field name="category_id"/><field name="version"/><field name="effective_date"/><field name="review_date"/><field name="reviewer_id"/><field name="last_reviewed_on"/><field name="acknowledgement_required"/><field name="document" filename="document_filename"/><field name="document_filename" invisible="1"/><field name="active"/></group><group string="Assignment"><field name="assignment_type"/><field name="assignment_department_id" invisible="assignment_type != 'department'" required="assignment_type == 'department'"/><field name="assignment_employee_id" invisible="assignment_type != 'employee'" required="assignment_type == 'employee'"/></group><group string="Acknowledgement Progress"><field name="acknowledged_count"/><field name="pending_count"/><field name="acknowledgement_total"/><field name="acknowledgement_progress"/></group><group string="Policy Content"><field name="content"/></group></sheet><chatter/></form></field></record>
 <record id="action_esg_policy" model="ir.actions.act_window"><field name="name">Policies</field><field name="res_model">esg.policy</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_policy_ack_tree" model="ir.ui.view"><field name="name">esg.policy.ack.tree</field><field name="model">esg.policy.acknowledgement</field><field name="arch" type="xml"><list><field name="policy_id"/><field name="policy_version"/><field name="employee_id"/><field name="department_id"/><field name="acknowledged_on"/><field name="state" widget="badge"/><button name="action_acknowledge" type="object" string="Acknowledge" invisible="state == 'acknowledged'"/></list></field></record>
 <record id="action_esg_policy_ack" model="ir.actions.act_window"><field name="name">Policy Acknowledgements</field><field name="res_model">esg.policy.acknowledgement</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_audit_tree" model="ir.ui.view"><field name="name">esg.audit.tree</field><field name="model">esg.audit</field><field name="arch" type="xml"><list><field name="name"/><field name="department_id"/><field name="auditor_id"/><field name="audit_date"/><field name="due_date"/><field name="findings"/><field name="evidence_filename"/><field name="state" widget="badge"/></list></field></record>
 <record id="action_esg_audit" model="ir.actions.act_window"><field name="name">Audits</field><field name="res_model">esg.audit</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_issue_tree" model="ir.ui.view"><field name="name">esg.issue.tree</field><field name="model">esg.compliance.issue</field><field name="arch" type="xml"><list decoration-danger="is_overdue"><field name="name"/><field name="severity" widget="badge"/><field name="department_id"/><field name="owner_id"/><field name="due_date"/><field name="is_overdue"/><field name="state" widget="badge"/><field name="evidence_filename"/><button name="action_review" type="object" string="Review" invisible="state != 'open'"/><button name="action_require_action" type="object" string="Action Required" invisible="state in ('action_required', 'resolved', 'rejected')"/><button name="action_resolve" type="object" string="Resolve" invisible="state == 'resolved'"/><button name="action_reject" type="object" string="Reject" invisible="state in ('resolved', 'rejected')"/></list></field></record>
 <record id="action_esg_issue" model="ir.actions.act_window"><field name="name">Compliance Issues</field><field name="res_model">esg.compliance.issue</field><field name="view_mode">list,form</field></record>
</odoo>

<odoo>
  <!-- ===================== CHALLENGE ===================== -->
  <record id="view_esg_challenge_search" model="ir.ui.view">
    <field name="name">esg.challenge.search</field>
    <field name="model">esg.challenge</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="category_id"/>
        <field name="difficulty"/>
        <!-- State filter pills (horizontal bar, Phase 11) -->
        <filter name="filter_draft"       string="Draft"        domain="[('state','=','draft')]"/>
        <filter name="filter_active"      string="Active"       domain="[('state','=','active')]"/>
        <filter name="filter_review"      string="Under Review" domain="[('state','=','under_review')]"/>
        <filter name="filter_completed"   string="Completed"    domain="[('state','=','completed')]"/>
        <filter name="filter_archived"    string="Archived"     domain="[('state','=','archived')]"/>
        <group expand="0" string="Group By">
          <filter name="group_state"      string="State"      context="{'group_by': 'state'}"/>
          <filter name="group_difficulty" string="Difficulty" context="{'group_by': 'difficulty'}"/>
          <filter name="group_deadline"   string="Deadline"   context="{'group_by': 'deadline:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_esg_challenge_tree" model="ir.ui.view">
    <field name="name">esg.challenge.tree</field>
    <field name="model">esg.challenge</field>
    <field name="arch" type="xml">
      <tree decoration-muted="state == 'archived'" decoration-success="state == 'completed'">
        <field name="name"/>
        <field name="category_id"/>
        <field name="difficulty"/>
        <field name="xp_value"/>
        <field name="deadline"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="view_esg_challenge_kanban" model="ir.ui.view">
    <field name="name">esg.challenge.kanban</field>
    <field name="model">esg.challenge</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" quick_create="false">
        <field name="name"/>
        <field name="xp_value"/>
        <field name="difficulty"/>
        <field name="deadline"/>
        <field name="state"/>
        <field name="evidence_required"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <strong><field name="name"/></strong>
              <div><field name="difficulty"/> · <field name="xp_value"/> XP</div>
              <div>Due: <field name="deadline"/></div>
              <div><field name="state" widget="badge"/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_esg_challenge_form" model="ir.ui.view">
    <field name="name">esg.challenge.form</field>
    <field name="model">esg.challenge</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" type="object" string="Activate"     invisible="state != 'draft'"/>
          <button name="action_review"   type="object" string="Send to Review" invisible="state != 'active'"/>
          <button name="action_complete" type="object" string="Complete"     invisible="state != 'under_review'"/>
          <button name="action_archive"  type="object" string="Archive"      invisible="state == 'archived'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,under_review,completed,archived"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="category_id"/>
            <field name="xp_value"/>
            <field name="difficulty"/>
            <field name="deadline"/>
            <field name="evidence_required"/>
          </group>
          <field name="description"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_esg_challenge" model="ir.actions.act_window">
    <field name="name">Challenges</field>
    <field name="res_model">esg.challenge</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_esg_challenge_search"/>
  </record>

  <!-- ===================== CHALLENGE PARTICIPATION ===================== -->
  <record id="view_esg_challenge_part_tree" model="ir.ui.view">
    <field name="name">esg.challenge.part.tree</field>
    <field name="model">esg.challenge.participation</field>
    <field name="arch" type="xml">
      <tree>
        <field name="employee_id"/>
        <field name="challenge_id"/>
        <field name="progress" widget="progressbar"/>
        <field name="proof_filename"/>
        <field name="xp_awarded"/>
        <field name="state" widget="badge"/>
        <button name="action_submit"  type="object" string="Submit"  invisible="state != 'joined'"/>
        <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'under_review'"/>
        <button name="action_reject"  type="object" string="Reject"  class="btn-danger"  invisible="state != 'under_review'"/>
      </tree>
    </field>
  </record>

  <record id="action_esg_challenge_part" model="ir.actions.act_window">
    <field name="name">Challenge Participation</field>
    <field name="res_model">esg.challenge.participation</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ===================== BADGES ===================== -->
  <record id="view_esg_badge_tree" model="ir.ui.view">
    <field name="name">esg.badge.tree</field>
    <field name="model">esg.badge</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="minimum_xp"/>
        <field name="minimum_challenges"/>
      </tree>
    </field>
  </record>

  <record id="view_esg_badge_form" model="ir.ui.view">
    <field name="name">esg.badge.form</field>
    <field name="model">esg.badge</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="minimum_xp"/>
            <field name="minimum_challenges"/>
            <field name="description"/>
          </group>
          <field name="award_ids">
            <tree create="0" delete="0">
              <field name="employee_id"/>
              <field name="awarded_on"/>
            </tree>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_esg_badge" model="ir.actions.act_window">
    <field name="name">Badges</field>
    <field name="res_model">esg.badge</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ===================== REWARDS ===================== -->
  <record id="view_esg_reward_tree" model="ir.ui.view">
    <field name="name">esg.reward.tree</field>
    <field name="model">esg.reward</field>
    <field name="arch" type="xml">
      <tree decoration-danger="stock == 0">
        <field name="name"/>
        <field name="points_required"/>
        <field name="stock"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="action_esg_reward" model="ir.actions.act_window">
    <field name="name">Rewards</field>
    <field name="res_model">esg.reward</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ===================== REDEMPTIONS ===================== -->
  <record id="view_esg_redemption_tree" model="ir.ui.view">
    <field name="name">esg.redemption.tree</field>
    <field name="model">esg.reward.redemption</field>
    <field name="arch" type="xml">
      <tree>
        <field name="employee_id"/>
        <field name="reward_id"/>
        <field name="points_spent"/>
        <field name="redeemed_on"/>
        <field name="state" widget="badge"/>
        <button name="action_cancel" type="object" string="Cancel" invisible="state != 'requested'"/>
      </tree>
    </field>
  </record>

  <record id="action_esg_redemption" model="ir.actions.act_window">
    <field name="name">Reward Redemptions</field>
    <field name="res_model">esg.reward.redemption</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ===================== EMPLOYEE LEADERBOARD (Phase 13) ===================== -->
  <record id="view_esg_leaderboard_tree" model="ir.ui.view">
    <field name="name">esg.employee.leaderboard.tree</field>
    <field name="model">esg.employee.leaderboard</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" delete="0">
        <field name="rank"/>
        <field name="employee_id"/>
        <field name="department_id"/>
        <field name="total_xp"/>
        <field name="approved_challenges"/>
        <field name="badge_count"/>
      </tree>
    </field>
  </record>

  <record id="view_esg_leaderboard_search" model="ir.ui.view">
    <field name="name">esg.employee.leaderboard.search</field>
    <field name="model">esg.employee.leaderboard</field>
    <field name="arch" type="xml">
      <search>
        <field name="employee_id"/>
        <field name="department_id"/>
        <group expand="0" string="Group By">
          <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_esg_leaderboard_graph" model="ir.ui.view">
    <field name="name">esg.employee.leaderboard.graph</field>
    <field name="model">esg.employee.leaderboard</field>
    <field name="arch" type="xml">
      <graph string="Employee XP Ranking" type="bar">
        <field name="employee_id"/>
        <field name="total_xp" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="action_esg_employee_leaderboard" model="ir.actions.act_window">
    <field name="name">Employee Leaderboard</field>
    <field name="res_model">esg.employee.leaderboard</field>
    <field name="view_mode">list,graph</field>
    <field name="search_view_id" ref="view_esg_leaderboard_search"/>
  </record>

  <!-- ===================== DEPARTMENT SCORE (Phase 14 — Recalculate) ===================== -->
  <record id="view_esg_score_tree" model="ir.ui.view">
    <field name="name">esg.department.score.tree</field>
    <field name="model">esg.department.score</field>
    <field name="arch" type="xml">
      <tree>
        <field name="department_id"/>
        <field name="score_date"/>
        <field name="environmental_score"/>
        <field name="social_score"/>
        <field name="governance_score"/>
        <field name="total_score"/>
      </tree>
    </field>
  </record>

  <record id="view_esg_score_graph" model="ir.ui.view">
    <field name="name">esg.department.score.graph</field>
    <field name="model">esg.department.score</field>
    <field name="arch" type="xml">
      <graph string="Department ESG Ranking" type="bar">
        <field name="department_id"/>
        <field name="total_score" type="measure"/>
      </graph>
    </field>
  </record>

  <!-- Server action: Recalculate all scores now (Phase 14) -->
  <record id="action_esg_recalculate_scores" model="ir.actions.server">
    <field name="name">Recalculate ESG Scores Now</field>
    <field name="model_id" ref="model_esg_department_score"/>
    <field name="binding_model_id" ref="model_esg_department_score"/>
    <field name="state">code</field>
    <field name="code">model.action_recalculate_all()</field>
  </record>

  <record id="action_esg_score" model="ir.actions.act_window">
    <field name="name">Department ESG Scores</field>
    <field name="res_model">esg.department.score</field>
    <field name="view_mode">list,graph,pivot</field>
  </record>
</odoo>

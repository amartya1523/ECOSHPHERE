<odoo>
 <record id="view_esg_csr_kanban" model="ir.ui.view"><field name="name">esg.csr.kanban</field><field name="model">esg.csr.activity</field><field name="arch" type="xml"><kanban><field name="name"/><field name="department_id"/><field name="activity_date"/><field name="evidence_required"/><field name="participant_count"/><templates><t t-name="card"><div class="oe_kanban_global_click"><strong><field name="name"/></strong><div><field name="department_id"/> · <field name="activity_date"/></div><div>Participants: <field name="participant_count"/></div><div t-if="record.evidence_required.raw_value">Evidence required</div></div></t></templates></kanban></field></record>
 <record id="action_esg_csr_activity" model="ir.actions.act_window"><field name="name">CSR Activities</field><field name="res_model">esg.csr.activity</field><field name="view_mode">kanban,list,form</field></record>
 <record id="view_esg_csr_part_tree" model="ir.ui.view"><field name="name">esg.csr.part.tree</field><field name="model">esg.csr.participation</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="activity_id"/><field name="proof_filename"/><field name="completion_date"/><field name="points_earned"/><field name="state" widget="badge"/><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state not in ['draft', 'submitted']"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['draft', 'submitted']"/></list></field></record>
 <record id="action_esg_csr_participation" model="ir.actions.act_window"><field name="name">Employee Participation</field><field name="res_model">esg.csr.participation</field><field name="view_mode">list,form</field></record>
 <record id="view_esg_diversity_metric_tree" model="ir.ui.view"><field name="name">esg.diversity.metric.tree</field><field name="model">esg.diversity.metric</field><field name="arch" type="xml"><list><field name="department_id"/><field name="metric_type"/><field name="value"/><field name="period"/><field name="notes"/></list></field></record>
 <record id="view_esg_diversity_metric_search" model="ir.ui.view"><field name="name">esg.diversity.metric.search</field><field name="model">esg.diversity.metric</field><field name="arch" type="xml"><search><field name="department_id"/><field name="period"/><group expand="0" string="Group By"><filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/></group></search></field></record>
 <record id="action_esg_diversity_metric" model="ir.actions.act_window"><field name="name">Diversity Metrics</field><field name="res_model">esg.diversity.metric</field><field name="view_mode">list,form,graph,pivot</field><field name="search_view_id" ref="view_esg_diversity_metric_search"/></record>
 <record id="view_esg_training_completion_tree" model="ir.ui.view"><field name="name">esg.training.completion.tree</field><field name="model">esg.training.completion</field><field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="department_id"/><field name="completion_date"/><field name="status" widget="badge"/><field name="certificate_filename"/></list></field></record>
 <record id="view_esg_training_completion_search" model="ir.ui.view"><field name="name">esg.training.completion.search</field><field name="model">esg.training.completion</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="department_id"/><filter name="completed" string="Completed" domain="[('status', '=', 'completed')]"/><group expand="0" string="Group By"><filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/></group></search></field></record>
 <record id="action_esg_training_completion" model="ir.actions.act_window"><field name="name">Training Completion</field><field name="res_model">esg.training.completion</field><field name="view_mode">list,form,graph,pivot</field><field name="search_view_id" ref="view_esg_training_completion_search"/></record>
</odoo>
